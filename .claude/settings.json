{
  "permissions": {
    "deny": [
      "Edit(./.claude/**)",
      "Edit(./.gitleaks.toml)",
      "Edit(./.pre-commit-config.yaml)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_secrets.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
